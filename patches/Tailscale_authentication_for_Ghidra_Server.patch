+	/**
+	 * Returns the raw {@link InetAddress} of the current RMI client (without reverse
+	 * DNS resolution). Must be invoked from within the RMI dispatch thread.
+	 *
+	 * @return the client address, or null if it can't be determined
+	 */
+	public static InetAddress getRMIClientAddress() {
+		Thread currentThread = Thread.currentThread();
+		if (!currentThread.getName().startsWith("RMI TCP Connection")) {
+			return null;
+		}
+		try {
+			String host = RemoteServer.getClientHost();
+			if (host == null) {
+				return null;
+			}
+			return InetAddress.getByName(host);
+		}
+		catch (ServerNotActiveException | UnknownHostException e) {
+			return null;
+		}
+	}
