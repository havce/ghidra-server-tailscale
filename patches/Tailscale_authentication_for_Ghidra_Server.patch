+package ghidra.server.security;
+
+import java.io.IOException;
+import java.io.InputStream;
+import java.net.InetAddress;
+import java.nio.charset.StandardCharsets;
+import java.util.concurrent.TimeUnit;
+
+import org.apache.logging.log4j.LogManager;
+import org.apache.logging.log4j.Logger;
+
+import com.google.gson.JsonElement;
+import com.google.gson.JsonObject;
+import com.google.gson.JsonParser;
+
+/**
+ * Resolves a client's Tailscale identity by invoking {@code tailscale whois --json <ip>}.
+ * The {@code UserProfile.LoginName} returned by Tailscale (e.g. {@code alice@github}) is
+ * reduced to a local identifier usable as a Ghidra username.
+ */
+public class TailscaleIdentityResolver {
+
+	private static final Logger log = LogManager.getLogger(TailscaleIdentityResolver.class);
+
+	private static final String TAILSCALE_COMMAND =
+		System.getProperty("ghidra.server.tailscale.cli", "tailscale");
+	private static final long CLI_TIMEOUT_SECONDS = 5;
+
+	private TailscaleIdentityResolver() {
+	}
+
+	/**
+	 * Resolves the Tailscale-derived username for the given client address, or
+	 * {@code null} if the CLI is unavailable, the address is unknown to Tailscale,
+	 * or the user has no usable login name.
+	 *
+	 * @param clientAddress the client's source address (raw, not reverse-resolved)
+	 * @return the resolved username or null
+	 */
+	public static String resolve(InetAddress clientAddress) {
+		if (clientAddress == null) {
+			return null;
+		}
+		String json = runWhois(clientAddress.getHostAddress());
+		if (json == null) {
+			return null;
+		}
+		return parseUsername(json);
+	}
+
+	private static String runWhois(String ip) {
+		Process process = null;
+		try {
+			ProcessBuilder pb =
+				new ProcessBuilder(TAILSCALE_COMMAND, "whois", "--json", ip);
+			process = pb.start();
+			// Drain stderr concurrently so the child can't block on a full pipe,
+			// and so "Warning: ..." lines don't corrupt the JSON on stdout.
+			StringBuilder stderrBuf = new StringBuilder();
+			Process p = process;
+			Thread errDrain = new Thread(() -> {
+				try (InputStream err = p.getErrorStream()) {
+					stderrBuf.append(new String(err.readAllBytes(), StandardCharsets.UTF_8));
+				}
+				catch (IOException ignored) {
+					// child already gone
+				}
+			}, "tailscale-whois-stderr");
+			errDrain.setDaemon(true);
+			errDrain.start();
+			String output;
+			try (InputStream in = process.getInputStream()) {
+				output = new String(in.readAllBytes(), StandardCharsets.UTF_8);
+			}
+			if (!process.waitFor(CLI_TIMEOUT_SECONDS, TimeUnit.SECONDS)) {
+				process.destroyForcibly();
+				log.warn("tailscale whois timed out after " + CLI_TIMEOUT_SECONDS + "s");
+				return null;
+			}
+			errDrain.join(TimeUnit.SECONDS.toMillis(1));
+			String stderr = stderrBuf.toString().trim();
+			if (process.exitValue() != 0) {
+				log.warn("tailscale whois " + ip + " exited " + process.exitValue() + ": " +
+					(stderr.isEmpty() ? output.trim() : stderr));
+				return null;
+			}
+			if (!stderr.isEmpty()) {
+				log.debug("tailscale whois stderr: " + stderr);
+			}
+			return output;
+		}
+		catch (IOException e) {
+			log.warn("Failed to invoke tailscale CLI ('" + TAILSCALE_COMMAND + "'): " +
+				e.getMessage());
+			return null;
+		}
+		catch (InterruptedException e) {
+			if (process != null) {
+				process.destroyForcibly();
+			}
+			Thread.currentThread().interrupt();
+			return null;
+		}
+	}
+
+	private static String parseUsername(String json) {
+		try {
+			JsonObject root = JsonParser.parseString(json).getAsJsonObject();
+			JsonElement profile = root.get("UserProfile");
+			if (profile == null || !profile.isJsonObject()) {
+				return null;
+			}
+			JsonElement loginName = profile.getAsJsonObject().get("LoginName");
+			if (loginName == null) {
+				return null;
+			}
+			return toGhidraUsername(loginName.getAsString());
+		}
+		catch (RuntimeException e) {
+			log.warn("Failed to parse tailscale whois JSON: " + e.getMessage());
+			return null;
+		}
+	}
+
+	/**
+	 * Reduce a Tailscale LoginName (e.g. {@code "alice@github"}, {@code "bob@example.com"})
+	 * to the local-part used as a Ghidra username. Tailscale uses {@code <handle>@github}
+	 * for GitHub OAuth users, so this yields the bare GitHub handle.
+	 */
+	static String toGhidraUsername(String loginName) {
+		if (loginName == null) {
+			return null;
+		}
+		String trimmed = loginName.trim();
+		if (trimmed.isEmpty()) {
+			return null;
+		}
+		int at = trimmed.indexOf('@');
+		String local = at > 0 ? trimmed.substring(0, at) : trimmed;
+		return local.isEmpty() ? null : local;
+	}
+}
